{
  "$schema": "https://opencode.ai/config.json",
  "websearch": false,
  "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny"
    },
    "edit": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "ask",
      "sed": "deny",
      "sed *": "deny",
      "rm *": "deny",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "dotnet build *": "allow",
      "dotnet test *": "allow",
      "cargo build *": "allow",
      "cargo test *": "allow",
      "pytest *": "allow",
      "python -m pytest *": "allow",
      "cmake --build *": "allow",
      "latexmk *": "allow",
      "lualatex *": "allow",
      "biber *": "allow"
    }
  }
}
